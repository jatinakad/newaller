# ===========================================
# AllerSense — AWS Production Environment
# ===========================================
# Copy this to .env and fill in your values before deploying.

# Database (RDS PostgreSQL)
DATABASE_URL=postgresql+asyncpg://allersense:YOUR_RDS_PASSWORD@YOUR_RDS_ENDPOINT:5432/allersense
DATABASE_URL_SYNC=postgresql://allersense:YOUR_RDS_PASSWORD@YOUR_RDS_ENDPOINT:5432/allersense

# Redis (keep your existing Redis Cloud, or use ElastiCache)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT

# AI Backend
AI_BACKEND=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# AWS S3 (report file storage)
USE_S3=true
S3_BUCKET=allersense-reports
S3_REGION=us-east-1
# Leave these empty if using IAM role (recommended for App Runner)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# App
APP_ENV=production
APP_SECRET_KEY=GENERATE_A_RANDOM_SECRET_HERE
APP_DEBUG=false
CORS_ORIGINS=https://YOUR_FRONTEND_URL

# OpenFDA
OPENFDA_API_URL=https://api.fda.gov/drug
