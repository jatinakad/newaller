# Database

DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:admin@localhost:5432/postgres
# Redis / Valkey
# REDIS_URL=redis://valkey:6379/0
REDIS_URL=

# AI Backend: "gemini", "ollama", "huggingface_local", "huggingface_api"
AI_BACKEND=gemini

# Gemini settings (Google AI Studio - get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Ollama settings (used when AI_BACKEND=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=medgemma:4b

# HuggingFace settings (used when AI_BACKEND=huggingface_local or huggingface_api)
HF_MODEL_ID=google/medgemma-4b-it
HF_TOKEN=
HF_DEVICE=auto
HF_TORCH_DTYPE=auto
HF_MAX_NEW_TOKENS=1024

# MinIO (S3-compatible)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=prescriptions
MINIO_USE_SSL=false

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=medguard
KEYCLOAK_CLIENT_ID=medguard-api
KEYCLOAK_PUBLIC_KEY=

# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# OpenFDA
OPENFDA_API_URL=https://api.fda.gov/drug
